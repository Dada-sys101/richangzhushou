generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  DELETION_PENDING
  DELETION_PROCESSING
  DELETED
}

enum TransactionType {
  EXPENSE
  INCOME
  REFUND
}

enum RecordStatus {
  DRAFT
  CONFIRMED
  DELETED
}

enum RecordSource {
  MANUAL
  SHORTCUT
  TEXT
  VOICE
  IMPORT
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum FinancialAccountKind {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  DIGITAL_WALLET
  OTHER
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
  SUPPRESSED
}

enum ReminderScheduleType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderTargetType {
  CALENDAR_EVENT
  TASK
  STANDALONE
}

enum SyncState {
  SYNCED
  PENDING_SYNC
  SYNC_FAILED
  CONFLICT
}

enum SyncEntityType {
  TRANSACTION
  CATEGORY
  FINANCIAL_ACCOUNT
  BUDGET
  CALENDAR_EVENT
  TASK
  REMINDER
  TRIP
  TRIP_ITEM
  PACKING_ITEM
  DRAFT_RECORD
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum SyncMutationStatus {
  APPLIED
  CONFLICTED
  FAILED
}

enum DraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
  FAILED
}

enum AttachmentOwnerType {
  TRANSACTION_DRAFT
}

enum DraftTargetType {
  TRANSACTION
}

enum TripItemType {
  TRANSPORT
  STAY
  ACTIVITY
  FOOD
  OTHER
}

enum RecurrenceEngine {
  RRULE_TEMPORAL
}

enum RecurrenceTimeMode {
  WALL_CLOCK
  ABSOLUTE_INSTANT
}

enum RecurrenceBackfillStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
  MISMATCH
  FAILED
}

enum RecurrenceExceptionType {
  CANCEL
  REPLACE
}

model SystemSetting {
  id                  String   @id @default("singleton")
  maxActiveUsers      Int      @default(20) @map("max_active_users")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedBy           String?  @map("updated_by")

  @@map("system_settings")
}

model User {
  id                  String             @id @default(cuid())
  username            String             @unique
  normalizedUsername  String             @unique @map("normalized_username")
  displayName         String             @map("display_name")
  passwordHash        String             @map("password_hash")
  mustChangePassword  Boolean            @default(false) @map("must_change_password")
  role                UserRole           @default(USER)
  status              UserStatus         @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  closedAt            DateTime?          @map("closed_at")
  deletionRequestedAt DateTime?          @map("deletion_requested_at")
  deletionScheduledAt DateTime?          @map("deletion_scheduled_at")
  deletionStartedAt   DateTime?          @map("deletion_started_at")
  deletionCompletedAt DateTime?          @map("deletion_completed_at")
  deletionAttemptCount Int               @default(0) @map("deletion_attempt_count")
  deletionLastError   String?            @map("deletion_last_error") @db.VarChar(500)
  deletionLeaseExpiresAt DateTime?       @map("deletion_lease_expires_at")
  lastLoginAt         DateTime?          @map("last_login_at")
  sessions            Session[]
  adminAudits         AdminAudit[]
  categories          Category[]
  financialAccounts   FinancialAccount[]
  transactions        Transaction[]
  budgets             Budget[]
  deviceCredentials   DeviceCredential[]
  drafts              DraftRecord[]
  attachments         Attachment[]
  calendarEvents      CalendarEvent[]
  tasks               Task[]
  reminders           Reminder[]
  trips               Trip[]
  syncMutations       SyncMutation[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  reason     String
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audits")
}

model Category {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  kind         CategoryKind
  name         String        @db.VarChar(40)
  color        String        @default("#64748B") @db.VarChar(7)
  isArchived   Boolean       @default(false) @map("is_archived")
  clientMutationId String?   @unique @map("client_mutation_id")
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, kind, name])
  @@index([userId, isArchived])
  @@index([userId, updatedAt])
  @@map("categories")
}

model FinancialAccount {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  name         String               @db.VarChar(40)
  kind         FinancialAccountKind
  isArchived   Boolean              @default(false) @map("is_archived")
  clientMutationId String?          @unique @map("client_mutation_id")
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, isArchived])
  @@index([userId, updatedAt])
  @@map("financial_accounts")
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String            @map("user_id")
  type                  TransactionType
  status                RecordStatus      @default(CONFIRMED)
  amount                Decimal           @db.Decimal(18, 2)
  currency              String            @default("CNY") @db.VarChar(3)
  categoryId            String?           @map("category_id")
  accountId             String?           @map("account_id")
  merchant              String?           @map("merchant") @db.VarChar(100)
  occurredAt            DateTime          @map("occurred_at")
  note                  String?           @db.VarChar(500)
  source                RecordSource      @default(MANUAL)
  originalTransactionId String?           @map("original_transaction_id")
  isUnlinkedRefund      Boolean           @default(false) @map("is_unlinked_refund")
  sourceFingerprint     String?           @map("source_fingerprint") @db.VarChar(128)
  tripId                String?           @map("trip_id")
  clientMutationId      String?           @unique @map("client_mutation_id")
  version               Int               @default(1)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account               FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  originalTransaction   Transaction?      @relation("RefundOriginal", fields: [originalTransactionId], references: [id], onDelete: SetNull)
  refunds               Transaction[]     @relation("RefundOriginal")
  trip                  Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([userId, status, deletedAt])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([userId, tripId])
  @@index([userId, updatedAt])
  @@map("transactions")
}

model Budget {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  categoryId String?   @map("category_id")
  month      String    @db.VarChar(7)
  amount     Decimal   @db.Decimal(18, 2)
  currency   String    @default("CNY") @db.VarChar(3)
  clientMutationId String? @unique @map("client_mutation_id")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, month, categoryId])
  @@index([userId, month])
  @@index([userId, categoryId])
  @@index([userId, updatedAt])
  @@map("budgets")
}

model DeviceCredential {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String   @db.VarChar(60)
  tokenHash  String   @unique @map("token_hash")
  tokenPrefix String  @map("token_prefix") @db.VarChar(8)
  scopes     Json     @map("scopes")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, createdAt])
  @@map("device_credentials")
}

model Attachment {
  id                   String              @id @default(cuid())
  userId               String              @map("user_id")
  ownerType            AttachmentOwnerType @map("owner_type")
  ownerId              String?             @map("owner_id")
  objectKey            String              @unique @map("object_key")
  mimeType             String              @map("mime_type") @db.VarChar(100)
  size                 Int                 @map("size")
  sha256               String?             @map("sha256") @db.VarChar(64)
  uploadTokenHash      String?             @unique @map("upload_token_hash") @db.VarChar(64)
  uploadIntentExpiresAt DateTime?          @map("upload_intent_expires_at")
  contentStoredAt      DateTime?           @map("content_stored_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts               DraftRecord[]

  @@index([userId, ownerType, ownerId])
  @@index([userId, createdAt])
  @@map("attachments")
}

model DraftRecord {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  source           RecordSource    @map("source")
  targetType       DraftTargetType @map("target_type")
  payloadJson      Json            @map("payload_json")
  confidenceJson   Json?           @map("confidence_json")
  status           DraftStatus     @default(PENDING)
  clientMutationId String?         @unique @map("client_mutation_id")
  attachmentId     String?         @map("attachment_id")
  failureReason    String?         @map("failure_reason") @db.VarChar(200)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  confirmedAt      DateTime?       @map("confirmed_at")
  discardedAt      DateTime?       @map("discarded_at")
  resultId         String?         @map("result_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment       Attachment?     @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@map("draft_records")
}

model CalendarEvent {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  title            String              @db.VarChar(200)
  startsAt         DateTime            @map("starts_at")
  endsAt           DateTime            @map("ends_at")
  allDay           Boolean             @default(false) @map("all_day")
  status           CalendarEventStatus @default(SCHEDULED)
  clientMutationId String?             @unique @map("client_mutation_id")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([userId, status, deletedAt])
  @@index([userId, updatedAt])
  @@map("calendar_events")
}

model Task {
  id               String     @id @default(cuid())
  userId           String     @map("user_id")
  title            String     @db.VarChar(200)
  status           TaskStatus @default(OPEN)
  priority         Priority   @default(MEDIUM)
  dueAt            DateTime?  @map("due_at")
  completedAt      DateTime?  @map("completed_at")
  cancelledAt      DateTime?  @map("cancelled_at")
  clientMutationId String?    @unique @map("client_mutation_id")
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, status, deletedAt])
  @@index([userId, updatedAt])
  @@map("tasks")
}

model Reminder {
  id               String               @id @default(cuid())
  userId           String               @map("user_id")
  title            String               @db.VarChar(200)
  note             String?              @db.VarChar(500)
  targetType       ReminderTargetType   @default(STANDALONE) @map("target_type")
  targetId         String?              @map("target_id")
  scheduleType     ReminderScheduleType @map("schedule_type")
  startsAt         DateTime             @map("starts_at")
  scheduledAt      DateTime             @map("scheduled_at")
  recurrenceJson   Json?                @map("recurrence_json")
  status           ReminderStatus       @default(SCHEDULED)
  attemptCount     Int                  @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?            @map("next_attempt_at")
  lastAttemptAt    DateTime?            @map("last_attempt_at")
  sentAt           DateTime?            @map("sent_at")
  suppressedAt     DateTime?            @map("suppressed_at")
  failureReason    String?              @map("failure_reason") @db.VarChar(200)
  lastErrorCode    String?              @map("last_error_code") @db.VarChar(50)
  clientMutationId String?              @unique @map("client_mutation_id")
  version          Int                  @default(1)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceRule   ReminderRecurrenceRule?

  @@index([userId, status, scheduledAt])
  @@index([userId, deletedAt])
  @@index([status, scheduledAt, nextAttemptAt])
  @@index([userId, updatedAt])
  @@map("reminders")
}

model ReminderRecurrenceRule {
  id                     String                   @id @default(cuid())
  reminderId             String                   @map("reminder_id")
  engine                 RecurrenceEngine         @default(RRULE_TEMPORAL)
  schemaVersion          Int                      @default(1) @map("schema_version") @db.SmallInt
  rruleText              String                   @map("rrule_text") @db.Text
  timeZoneId             String                   @map("time_zone_id") @db.VarChar(64)
  timeMode               RecurrenceTimeMode       @default(WALL_CLOCK) @map("time_mode")
  dtstartLocal           DateTime?                @map("dtstart_local")
  dtstartInstant         DateTime                 @map("dtstart_instant")
  canonicalHash          String                   @map("canonical_hash") @db.Char(64)
  parentRuleId           String?                  @map("parent_rule_id")
  splitFromOccurrenceKey String?                  @map("split_from_occurrence_key") @db.VarChar(128)
  backfillStatus         RecurrenceBackfillStatus @default(PENDING) @map("backfill_status")
  backfilledAt           DateTime?                @map("backfilled_at")
  dualReadVerifiedAt     DateTime?                @map("dual_read_verified_at")
  parityMismatchCount    Int                      @default(0) @map("parity_mismatch_count")
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  reminder               Reminder                 @relation(fields: [reminderId], references: [id], onDelete: Cascade, map: "rrule_reminder_id_fkey")
  parentRule             ReminderRecurrenceRule?  @relation("ReminderRecurrenceRuleParent", fields: [parentRuleId], references: [id], onDelete: SetNull, map: "rrule_parent_rule_id_fkey")
  childRules             ReminderRecurrenceRule[] @relation("ReminderRecurrenceRuleParent")
  exceptions             ReminderRecurrenceException[]

  @@unique([reminderId], map: "rrule_reminder_id_key")
  @@index([parentRuleId], map: "rrule_parent_rule_id_idx")
  @@index([backfillStatus], map: "rrule_backfill_status_idx")
  @@index([timeZoneId], map: "rrule_time_zone_id_idx")
  @@index([dualReadVerifiedAt], map: "rrule_dual_read_verified_at_idx")
  @@map("reminder_recurrence_rules")
}

model ReminderRecurrenceException {
  id                       String                  @id @default(cuid())
  recurrenceRuleId         String                  @map("recurrence_rule_id")
  occurrenceKey            String                  @map("occurrence_key") @db.VarChar(128)
  originalOccurrenceAt     DateTime                @map("original_occurrence_at")
  exceptionType            RecurrenceExceptionType @map("exception_type")
  replacementLocalAt       DateTime?               @map("replacement_local_at")
  replacementInstantAt     DateTime?               @map("replacement_instant_at")
  replacementTimeZoneId    String?                 @map("replacement_time_zone_id") @db.VarChar(64)
  replacementPayloadJson   Json?                   @map("replacement_payload_json")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  recurrenceRule           ReminderRecurrenceRule  @relation(fields: [recurrenceRuleId], references: [id], onDelete: Cascade, map: "rrule_exception_rule_id_fkey")

  @@unique([recurrenceRuleId, occurrenceKey], map: "rrule_exception_occurrence_key")
  @@index([recurrenceRuleId, originalOccurrenceAt], map: "rrule_exception_original_at_idx")
  @@map("reminder_recurrence_exceptions")
}

model Trip {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  title            String        @db.VarChar(200)
  destination      String        @db.VarChar(200)
  startDate        DateTime      @map("start_date") @db.Date
  endDate          DateTime      @map("end_date") @db.Date
  budgetAmount     Decimal?      @map("budget_amount") @db.Decimal(18, 2)
  clientMutationId String?       @unique @map("client_mutation_id")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            TripItem[]
  packingItems     PackingItem[]
  transactions     Transaction[]

  @@index([userId, startDate])
  @@index([userId, deletedAt])
  @@index([userId, updatedAt])
  @@map("trips")
}

model TripItem {
  id               String        @id @default(cuid())
  tripId           String        @map("trip_id")
  type             TripItemType
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime      @map("ends_at")
  location         String?       @db.VarChar(200)
  position         Int
  clientMutationId String?       @unique @map("client_mutation_id")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
  @@index([tripId, deletedAt])
  @@index([tripId, updatedAt])
  @@map("trip_items")
}

model PackingItem {
  id               String        @id @default(cuid())
  tripId           String        @map("trip_id")
  text             String        @db.VarChar(200)
  checked          Boolean       @default(false)
  position         Int
  clientMutationId String?       @unique @map("client_mutation_id")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
  @@index([tripId, deletedAt])
  @@index([tripId, updatedAt])
  @@map("packing_items")
}

model SyncMutation {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  clientMutationId String             @map("client_mutation_id")
  entityType       SyncEntityType     @map("entity_type")
  entityId         String?            @map("entity_id")
  action           SyncAction
  requestHash      String             @map("request_hash") @db.VarChar(64)
  resultRef        Json?              @map("result_ref")
  status           SyncMutationStatus @default(FAILED)
  errorCode        String?            @map("error_code") @db.VarChar(50)
  errorMessage     String?            @map("error_message") @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientMutationId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("sync_mutations")
}
