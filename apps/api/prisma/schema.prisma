generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  DELETION_PENDING
  DELETED
}

enum InviteStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

enum RecoveryCodeKind {
  PASSWORD_RESET
  REOPEN
}

enum TransactionType {
  EXPENSE
  INCOME
  REFUND
}

enum RecordStatus {
  DRAFT
  CONFIRMED
  DELETED
}

enum RecordSource {
  MANUAL
  SHORTCUT
  OCR
  TEXT
  VOICE
  IMPORT
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum FinancialAccountKind {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  DIGITAL_WALLET
  OTHER
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
  SUPPRESSED
}

enum ReminderScheduleType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderTargetType {
  CALENDAR_EVENT
  TASK
  STANDALONE
}

enum SyncState {
  SYNCED
  PENDING_SYNC
  SYNC_FAILED
  CONFLICT
}

enum DraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
  FAILED
}

enum AttachmentScanStatus {
  PENDING
  SCANNED
  FAILED
}

enum AttachmentOwnerType {
  TRANSACTION_DRAFT
}

enum DraftTargetType {
  TRANSACTION
}

enum TripItemType {
  TRANSPORT
  STAY
  ACTIVITY
  FOOD
  OTHER
}

model SystemSetting {
  id                  String   @id @default("singleton")
  registrationEnabled Boolean  @default(false) @map("registration_enabled")
  inviteRequired      Boolean  @default(true) @map("invite_required")
  maxActiveUsers      Int      @default(20) @map("max_active_users")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedBy           String?  @map("updated_by")

  @@map("system_settings")
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  normalizedEmail     String             @unique @map("normalized_email")
  displayName         String             @map("display_name")
  passwordHash        String             @map("password_hash")
  role                UserRole           @default(USER)
  status              UserStatus         @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  closedAt            DateTime?          @map("closed_at")
  deletionRequestedAt DateTime?          @map("deletion_requested_at")
  lastLoginAt         DateTime?          @map("last_login_at")
  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  invitedBy           InviteRedemption?
  adminAudits         AdminAudit[]
  inviteCodesCreated  InviteCode[]       @relation("InviteCreator")
  inviteCodesRevoked  InviteCode[]       @relation("InviteRevoker")
  categories          Category[]
  financialAccounts   FinancialAccount[]
  transactions        Transaction[]
  budgets             Budget[]
  deviceCredentials   DeviceCredential[]
  drafts              DraftRecord[]
  attachments         Attachment[]
  calendarEvents      CalendarEvent[]
  tasks               Task[]
  reminders           Reminder[]
  trips               Trip[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RecoveryCode {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  kind      RecoveryCodeKind
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, usedAt])
  @@index([expiresAt])
  @@map("recovery_codes")
}

model InviteCode {
  id          String             @id @default(cuid())
  codeHash    String             @unique @map("code_hash")
  codePrefix  String             @map("code_prefix")
  status      InviteStatus       @default(ACTIVE)
  maxUses     Int                @default(1) @map("max_uses")
  usedCount   Int                @default(0) @map("used_count")
  expiresAt   DateTime?          @map("expires_at")
  revokedAt   DateTime?          @map("revoked_at")
  createdById String?            @map("created_by_id")
  revokedById String?            @map("revoked_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  createdBy   User?              @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy   User?              @relation("InviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  redemptions InviteRedemption[]

  @@index([status, expiresAt])
  @@index([createdById])
  @@map("invite_codes")
}

model InviteRedemption {
  id         String     @id @default(cuid())
  inviteId   String     @map("invite_id")
  userId     String     @unique @map("user_id")
  redeemedAt DateTime   @default(now()) @map("redeemed_at")
  invite     InviteCode @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@map("invite_redemptions")
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  reason     String
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audits")
}

model Category {
  id           String        @id @default(cuid())
  userId       String        @map("user_id")
  kind         CategoryKind
  name         String        @db.VarChar(40)
  color        String        @default("#64748B") @db.VarChar(7)
  isArchived   Boolean       @default(false) @map("is_archived")
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, kind, name])
  @@index([userId, isArchived])
  @@map("categories")
}

model FinancialAccount {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  name         String               @db.VarChar(40)
  kind         FinancialAccountKind
  isArchived   Boolean              @default(false) @map("is_archived")
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId, isArchived])
  @@map("financial_accounts")
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String            @map("user_id")
  type                  TransactionType
  status                RecordStatus      @default(CONFIRMED)
  amount                Decimal           @db.Decimal(18, 2)
  currency              String            @default("CNY") @db.VarChar(3)
  categoryId            String?           @map("category_id")
  accountId             String?           @map("account_id")
  merchant              String?           @map("merchant") @db.VarChar(100)
  occurredAt            DateTime          @map("occurred_at")
  note                  String?           @db.VarChar(500)
  source                RecordSource      @default(MANUAL)
  originalTransactionId String?           @map("original_transaction_id")
  isUnlinkedRefund      Boolean           @default(false) @map("is_unlinked_refund")
  sourceFingerprint     String?           @map("source_fingerprint") @db.VarChar(128)
  tripId                String?           @map("trip_id")
  clientMutationId      String?           @unique @map("client_mutation_id")
  version               Int               @default(1)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account               FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  originalTransaction   Transaction?      @relation("RefundOriginal", fields: [originalTransactionId], references: [id], onDelete: SetNull)
  refunds               Transaction[]     @relation("RefundOriginal")
  trip                  Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([userId, status, deletedAt])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([userId, tripId])
  @@map("transactions")
}

model Budget {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  categoryId String?   @map("category_id")
  month      String    @db.VarChar(7)
  amount     Decimal   @db.Decimal(18, 2)
  currency   String    @default("CNY") @db.VarChar(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, month, categoryId])
  @@index([userId, month])
  @@index([userId, categoryId])
  @@map("budgets")
}

model DeviceCredential {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String   @db.VarChar(60)
  tokenHash  String   @unique @map("token_hash")
  tokenPrefix String  @map("token_prefix") @db.VarChar(8)
  scopes     Json     @map("scopes")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, createdAt])
  @@map("device_credentials")
}

model Attachment {
  id                   String              @id @default(cuid())
  userId               String              @map("user_id")
  ownerType            AttachmentOwnerType @map("owner_type")
  ownerId              String?             @map("owner_id")
  objectKey            String              @unique @map("object_key")
  mimeType             String              @map("mime_type") @db.VarChar(100)
  size                 Int                 @map("size")
  sha256               String?             @map("sha256") @db.VarChar(64)
  scanStatus           AttachmentScanStatus @default(PENDING) @map("scan_status")
  uploadTokenHash      String?             @unique @map("upload_token_hash") @db.VarChar(64)
  uploadIntentExpiresAt DateTime?          @map("upload_intent_expires_at")
  contentStoredAt      DateTime?           @map("content_stored_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts               DraftRecord[]

  @@index([userId, ownerType, ownerId])
  @@index([userId, createdAt])
  @@map("attachments")
}

model DraftRecord {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  source           RecordSource    @map("source")
  targetType       DraftTargetType @map("target_type")
  payloadJson      Json            @map("payload_json")
  confidenceJson   Json?           @map("confidence_json")
  status           DraftStatus     @default(PENDING)
  clientMutationId String?         @unique @map("client_mutation_id")
  attachmentId     String?         @map("attachment_id")
  failureReason    String?         @map("failure_reason") @db.VarChar(200)
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  confirmedAt      DateTime?       @map("confirmed_at")
  discardedAt      DateTime?       @map("discarded_at")
  resultId         String?         @map("result_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment       Attachment?     @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@map("draft_records")
}

model CalendarEvent {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  title            String              @db.VarChar(200)
  startsAt         DateTime            @map("starts_at")
  endsAt           DateTime            @map("ends_at")
  allDay           Boolean             @default(false) @map("all_day")
  status           CalendarEventStatus @default(SCHEDULED)
  clientMutationId String?             @unique @map("client_mutation_id")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([userId, status, deletedAt])
  @@map("calendar_events")
}

model Task {
  id               String     @id @default(cuid())
  userId           String     @map("user_id")
  title            String     @db.VarChar(200)
  status           TaskStatus @default(OPEN)
  priority         Priority   @default(MEDIUM)
  dueAt            DateTime?  @map("due_at")
  completedAt      DateTime?  @map("completed_at")
  cancelledAt      DateTime?  @map("cancelled_at")
  clientMutationId String?    @unique @map("client_mutation_id")
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, status, deletedAt])
  @@map("tasks")
}

model Reminder {
  id               String               @id @default(cuid())
  userId           String               @map("user_id")
  title            String               @db.VarChar(200)
  note             String?              @db.VarChar(500)
  targetType       ReminderTargetType   @default(STANDALONE) @map("target_type")
  targetId         String?              @map("target_id")
  scheduleType     ReminderScheduleType @map("schedule_type")
  startsAt         DateTime             @map("starts_at")
  scheduledAt      DateTime             @map("scheduled_at")
  recurrenceJson   Json?                @map("recurrence_json")
  status           ReminderStatus       @default(SCHEDULED)
  attemptCount     Int                  @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?            @map("next_attempt_at")
  lastAttemptAt    DateTime?            @map("last_attempt_at")
  sentAt           DateTime?            @map("sent_at")
  suppressedAt     DateTime?            @map("suppressed_at")
  failureReason    String?              @map("failure_reason") @db.VarChar(200)
  lastErrorCode    String?              @map("last_error_code") @db.VarChar(50)
  clientMutationId String?              @unique @map("client_mutation_id")
  version          Int                  @default(1)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
  @@index([userId, deletedAt])
  @@index([status, scheduledAt, nextAttemptAt])
  @@map("reminders")
}

model Trip {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  title            String        @db.VarChar(200)
  destination      String        @db.VarChar(200)
  startDate        DateTime      @map("start_date") @db.Date
  endDate          DateTime      @map("end_date") @db.Date
  budgetAmount     Decimal?      @map("budget_amount") @db.Decimal(18, 2)
  clientMutationId String?       @unique @map("client_mutation_id")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            TripItem[]
  packingItems     PackingItem[]
  transactions     Transaction[]

  @@index([userId, startDate])
  @@index([userId, deletedAt])
  @@map("trips")
}

model TripItem {
  id               String        @id @default(cuid())
  tripId           String        @map("trip_id")
  type             TripItemType
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime      @map("ends_at")
  location         String?       @db.VarChar(200)
  position         Int
  clientMutationId String?       @unique @map("client_mutation_id")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
  @@index([tripId, deletedAt])
  @@map("trip_items")
}

model PackingItem {
  id               String        @id @default(cuid())
  tripId           String        @map("trip_id")
  text             String        @db.VarChar(200)
  checked          Boolean       @default(false)
  position         Int
  clientMutationId String?       @unique @map("client_mutation_id")
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
  @@index([tripId, deletedAt])
  @@map("packing_items")
}
