generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  DELETION_PENDING
  DELETED
}

enum InviteStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

enum TransactionType {
  EXPENSE
  INCOME
  REFUND
}

enum RecordStatus {
  DRAFT
  CONFIRMED
  DELETED
}

enum RecordSource {
  MANUAL
  SHORTCUT
  OCR
  TEXT
  VOICE
  IMPORT
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
  SUPPRESSED
}

enum SyncState {
  SYNCED
  PENDING_SYNC
  SYNC_FAILED
  CONFLICT
}

enum DraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
  FAILED
}
