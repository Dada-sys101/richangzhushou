# Local development only. Copy to .env and replace the password locally.
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
BUSINESS_TIME_ZONE=Asia/Shanghai
DATABASE_URL=mysql://daily_assistant:change-me-local-only@127.0.0.1:3306/daily_assistant
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
CONFIRMATION_TOKEN_SECRET=change-me-to-another-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# ADMIN_BOOTSTRAP_PASSWORD=set-only-when-running-the-bootstrap-cli

# Optional adapters and scheduler switches (local development defaults).
LOCAL_STORAGE_DIR=.local-storage
SHORTCUT_RATE_LIMIT=30
FAKE_NOTIFICATION_FAIL=false
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_INTERVAL_MS=30000
REMINDER_MAX_ATTEMPTS=3

# Object storage (OPEN-006): STORAGE_PROVIDER=local for development/test.
# STORAGE_PROVIDER=oss requires all STORAGE_* values below and is the only
# provider allowed when NODE_ENV=production (staging gate; never commit real
# credentials).
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=oss
# STORAGE_BUCKET=daily-assistant-staging
# STORAGE_REGION=cn-beijing
# STORAGE_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
# STORAGE_ACCESS_KEY_ID=<ram-access-key-id>
# STORAGE_ACCESS_KEY_SECRET=<ram-access-key-secret>

# Optional local demo seed.
# SEED_DEMO_USER=true
# DEMO_USER_USERNAME=demo
# DEMO_USER_PASSWORD=DemoUser123!
