{
  "name": "@daily-assistant/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "account-deletion:run": "tsx src/cli/account-deletion-run.ts",
    "bootstrap:admin": "tsx src/cli/bootstrap-admin.ts",
    "build": "nest build",
    "dev": "nest start --watch",
    "e2e:prepare": "tsx src/cli/e2e-prep.ts",
    "lint": "eslint src prisma.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migration:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run src/integration",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:mysql84:temporary": "tsx src/cli/validate-temporary-mysql84.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@daily-assistant/api-contracts": "^0.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ali-oss": "^6.23.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^24.10.4",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.7",
    "vitest": "^4.1.10"
  }
}
