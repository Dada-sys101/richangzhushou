{
  "name": "daily-assistant-v15-tech-selection-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rrule": "node --test tests/01-rrule.test.mjs",
    "test:local-encryption": "node --test tests/02-local-encryption.test.mjs",
    "test:indexeddb-migration": "node --test tests/03-canonical-json.test.mjs tests/03-indexeddb-migration.test.mjs tests/03-indexeddb-faults.test.mjs tests/03-indexeddb-timing-matrix.test.mjs",
    "test:indexeddb-faults": "node --test tests/03-indexeddb-faults.test.mjs",
    "test:indexeddb-timing": "node --test tests/03-indexeddb-timing-matrix.test.mjs",
    "bench:import": "node scripts/import-benchmark.mjs",
    "licenses": "node scripts/generate-notices.mjs",
    "poc": "mkdir -p results && node --test --test-reporter=spec tests/*.test.mjs | tee results/test-output.txt && node scripts/import-benchmark.mjs && node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "csv-parse": "7.0.2",
    "luxon": "3.7.2",
    "openai": "7.4.0",
    "read-excel-file": "9.3.5",
    "rrule": "2.8.1",
    "rrule-temporal": "2.0.2",
    "temporal-polyfill": "1.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  }
}
