# Copy to .env for local development only. Never commit real credentials.
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
BUSINESS_TIME_ZONE=Asia/Shanghai

# Local MySQL example only; replace the password in your untracked .env file.
DATABASE_URL=mysql://daily_assistant:change-me-local-only@127.0.0.1:3306/daily_assistant

# Exact comma-separated local origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# ADMIN_BOOTSTRAP_PASSWORD=set-only-when-running-the-bootstrap-cli

# Object storage (OPEN-006): local adapter for development/test only.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.local-storage

# Alibaba Cloud OSS is required for staging/production (never commit real credentials):
# STORAGE_PROVIDER=oss
# STORAGE_BUCKET=daily-assistant-staging
# STORAGE_REGION=cn-beijing
# STORAGE_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
# STORAGE_ACCESS_KEY_ID=<ram-access-key-id>
# STORAGE_ACCESS_KEY_SECRET=<ram-access-key-secret>

# Expired account deletion cleanup (OPEN-007)
# ACCOUNT_DELETION_RETENTION_DAYS=30
# ACCOUNT_DELETION_BATCH_SIZE=20
# ACCOUNT_DELETION_MAX_ATTEMPTS=5
# ACCOUNT_DELETION_LEASE_SECONDS=600
# ACCOUNT_DELETION_SCHEDULER_ENABLED=false
# ACCOUNT_DELETION_SCHEDULER_INTERVAL_MS=60000
